# =============================================
# JEMKO Backend — Variables de entorno
# Copiá este archivo como .env y completalo
# =============================================

# Puerto del servidor (default: 3000)
PORT=3000

# Clave para el panel de administración
ADMIN_USER=admin
ADMIN_PASSWORD=jemko2026

# ---- Google Sheets (opcional) ----
# Tutorial para obtener credenciales:
# https://developers.google.com/sheets/api/guides/authorizing
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SERVICE_ACCOUNT_EMAIL=tu-cuenta@proyecto.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SPREADSHEET_ID=1xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- CORS ----
# Dominio del frontend (ej: https://jemko.com.ar)
# Usar * en desarrollo, dominio real en producción
FRONTEND_URL=*
